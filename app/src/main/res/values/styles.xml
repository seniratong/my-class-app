<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GreetingMetaText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mid_autumn_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="GreetingTitleText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/mid_autumn_moon</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GreetingMessageText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mid_autumn_cream</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="GreetingNoteText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/mid_autumn_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="GreetingSignatureText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mid_autumn_accent</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="CourtButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_court_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
