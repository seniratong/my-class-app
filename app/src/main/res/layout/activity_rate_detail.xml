<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/rate_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/rate_detail_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#182237"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rate_detail_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:textColor="#46536B"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/rate_detail_amount"
                android:text="@string/rate_amount_label"
                android:textColor="#182237"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/rate_detail_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/rate_amount_hint"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/rate_detail_convert"
                style="@style/RateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rate_convert" />

            <TextView
                android:id="@+id/rate_detail_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityLiveRegion="polite"
                android:freezesText="true"
                android:gravity="center"
                android:textColor="#304396"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
