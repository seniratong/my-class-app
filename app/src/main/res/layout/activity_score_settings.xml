<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/court_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:title="@string/score_settings"
        app:titleTextColor="@color/court_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/score_settings_hint"
                android:textColor="@color/court_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/edit_score_a"
                android:text="@string/edit_team_a_score"
                android:textColor="@color/court_text"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edit_score_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="48dp"
                android:hint="@string/score_input_hint"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/edit_score_b"
                android:text="@string/edit_team_b_score"
                android:textColor="@color/court_text"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edit_score_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="48dp"
                android:hint="@string/score_input_hint"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/save_scores"
                    style="@style/CourtButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/save_scores" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/cancel_scores"
                    style="@style/CourtButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cancel_scores" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
