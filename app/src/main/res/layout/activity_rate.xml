<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:background="@android:color/white">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/rate_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:title="@string/rate_app_name"
        app:titleTextColor="#182237" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/rate_intro"
                android:textColor="#5B6473"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/rate_amount"
                android:text="@string/rate_amount_label"
                android:textColor="#182237"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/rate_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minHeight="56dp"
                android:hint="@string/rate_amount_hint"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/rate_convert_button"
                style="@style/RateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rate_convert" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rate_result"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityHeading="true"
                    android:text="@string/rate_result_title"
                    android:textColor="#2854C5"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/rate_dollar_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/rate_empty_result"
                    android:textColor="#182237"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/rate_euro_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/rate_empty_result"
                    android:textColor="#182237"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/rate_won_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/rate_empty_result"
                    android:textColor="#182237"
                    android:textSize="20sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/rate_fetch_button"
                style="@style/RateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/rate_fetch" />
            <TextView
                android:id="@+id/rate_network_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#5B6473"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/rate_current_title"
                android:textColor="#5B6473"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/rate_current_values"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#182237"
                android:textSize="16sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/rate_edit_button"
                style="@style/RateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/rate_edit_title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rate_example_note"
                android:textColor="#5B6473"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
